[Theme]
; Windows - IDS_THEME_DISPLAYNAME_EJECT
DisplayName=EJECT
SetLogonBackground=0

[Control Panel\Desktop]
Wallpaper=fixed
TileWallpaper=0
WallpaperStyle=10
Pattern=

[VisualStyles]
Path=%ResourceDir%\Themes\Eject\Eject.msstyles
ColorStyle=NormalColor
Size=NormalSize
AutoColorization=0
ColorizationColor=0XFF748090
SystemMode=Dark
AppMode=Dark

[boot]
SCRNSAVE.EXE=

[MasterThemeSelector]
MTSM=RJSPBS

[AppEvents\Schemes\Apps\.Default\.Default]
DefaultValue=%SystemRoot%\media\Windows Message Nudge.wav
[AppEvents\Schemes\Apps\.Default\CriticalBatteryAlarm]
DefaultValue=%SystemRoot%\media\Windows Message Nudge.wav
[AppEvents\Schemes\Apps\.Default\LowBatteryAlarm]
DefaultValue=%SystemRoot%\media\Windows Message Nudge.wav
[AppEvents\Schemes\Apps\.Default\Notification.Default]
DefaultValue=%SystemRoot%\media\Windows Message Nudge.wav
[AppEvents\Schemes\Apps\.Default\SystemAsterisk]
DefaultValue=%SystemRoot%\media\Windows Message Nudge.wav
[AppEvents\Schemes\Apps\.Default\SystemExclamation]
DefaultValue=%SystemRoot%\media\Windows Message Nudge.wav
[AppEvents\Schemes\Apps\.Default\SystemHand]
DefaultValue=%SystemRoot%\media\Windows Message Nudge.wav
[AppEvents\Schemes\Apps\.Default\SystemNotification]
DefaultValue=%SystemRoot%\media\Windows Message Nudge.wav
[AppEvents\Schemes\Apps\.Default\WindowsUAC]
DefaultValue=%SystemRoot%\media\Windows Message Nudge.wav